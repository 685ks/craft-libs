    "width": { "$type": "dimension", "$value": "1px", "$description": "panels draw their edge as 1px padding around the inner box (background: --line)" }
  },
  "shadow": {
    "$type": "shadow",
    "panel": { "$value": "0 24px 60px -24px rgba(0,0,0,.7)" },
    "sheet": { "$value": "0 30px 80px -20px rgba(0,0,0,.8)" },
    "focus": { "$value": "0 0 0 3px rgba(143,184,216,.18)", "$description": "input focus ring, with border-color accent" },
    "success-glow": { "$value": "0 0 30px -12px rgba(143,224,168,.7)", "$description": "kingdom card you can afford" },
    "figure": { "$value": "drop-shadow(0 14px 20px rgba(0,0,0,.45))", "$type": "string" }
  },
  "blur": {
    "$type": "dimension",
    "panel": { "$value": "14px" },
    "gate": { "$value": "12px" },
    "button": { "$value": "8px" },
    "scrim": { "$value": "3px" },
    "haze": { "$value": "70px" }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.8, 0.2, 1], "$description": "the house curve: rises, reveals, bars, sheet" },
      "spring": { "$value": [0.3, 1.6, 0.5, 1], "$description": "number pop" },
      "bounce": { "$value": [0.3, 1.5, 0.5, 1], "$description": "ticket drop" },
      "hop": { "$value": [0.5, 0, 0.5, 1], "$description": "loading diamonds" }
    },
    "duration": {
      "$type": "duration",
      "hover": { "$value": "200ms" },
      "focus": { "$value": "250ms" },
      "sheet": { "$value": "300ms" },
      "shake": { "$value": "500ms" },
      "pop": { "$value": "600ms" },
      "result-row": { "$value": "800ms", "$description": "each result row, staggered 120ms" },
      "letter": { "$value": "900ms", "$description": "hero title letters, staggered 30ms" },
      "reveal": { "$value": "1000ms" },
      "rise": { "$value": "1200ms" },
      "bar-fill": { "$value": "1600ms" },
      "camera-drift": { "$value": "650-1500ms", "$type": "string", "$description": "scroll fly-to between stops, smoothstep easing" },
      "haze": { "$value": "30s", "$description": "background haze rotation, alternate" }
    },
    "reducedMotion": { "$type": "string", "$value": "prefers-reduced-motion: all animations and transitions become .001ms; hidden-until-animated elements are shown at once" }
  },
  "breakpoint": {
    "$type": "dimension",
    "phone": { "$value": "700px", "$description": "max-width: stacked forms, centred stops, bottom-anchored panels, mandatory snap scrolling" },
    "desktop": { "$value": "701px", "$description": "min-width: long scroll between stops, no snap" },
    "gear-stage": { "$value": "660px", "$description": "Gear: slots arranged around the figure" },
