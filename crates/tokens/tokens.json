    "bg": {
      "base": { "$value": "#07090d", "$description": "--bg; page background and theme-color" },
      "sky-top": { "$value": "#06080c", "$description": "top of the fixed backdrop gradient" },
      "sky-bottom": { "$value": "#0a0d13", "$description": "bottom of the fixed backdrop gradient" },
      "sky-glow": { "$value": "#111823", "$description": "radial glow behind the map, 80% x 60% at 50% 60%" },
      "sheet": { "$value": "#0b0e14", "$description": "full-screen pop-up body; also Gear page --bg-1" },
      "avatar": { "$value": "#1a2230" },
      "map-tile": { "$value": "rgba(20,27,38,.55)", "$description": "canvas fill of the kingdom map" },
      "map-node": { "$value": "#0c0f16", "$description": "canvas fill of event circles on the map" }
    },
    "text": {
      "ink": { "$value": "#effcff", "$description": "--ink; body text and big numbers" },
      "strong": { "$value": "#e6eef5", "$description": "--neon-hi; headings, values, primary button fill" },
