      "heading": { "$value": "-0.01em" },
      "chip": { "$value": "0.08em" },
      "label": { "$value": "0.22em" },
      "eyebrow": { "$value": "0.24em" }
    },
    "numeric": { "$type": "string", "$value": "tabular-nums", "$description": "every number, input and count" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
