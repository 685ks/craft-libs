    "icon-button": { "$value": "40px", "$description": "34px inside the sheet header, 32px for card close" },
    "help-button": { "$value": "24px" },
    "avatar": { "$value": "56px" },
    "pin": { "$value": "8px" },
    "progress": { "$value": "10px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "3px", "$description": "ticket" },
    "sm": { "$value": "5px", "$description": "event bar" },
    "md": { "$value": "6px", "$description": "calendar day" },
    "lg": { "$value": "10px", "$description": "icon buttons, Gear inputs" },
    "xl": { "$value": "12px", "$description": "inputs, primary button, notes, errors" },
    "panel-inner": { "$value": "13px" },
    "panel": { "$value": "14px", "$description": "panels, stat tiles, kingdom cards, sheet" },
    "gate": { "$value": "18px", "$description": "Player ID gate; Gear stage card" },
