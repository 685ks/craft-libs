  },
  "size": {
    "$type": "dimension",
    "content-max": { "$value": "1180px" },
    "panel": { "$value": "560px" },
    "panel-wide": { "$value": "640px" },
    "gate": { "$value": "460px" },
    "soon-card": { "$value": "400px" },
