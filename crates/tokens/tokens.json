    "5": { "$value": "20px" },
    "5-5": { "$value": "22px" },
    "6": { "$value": "26px", "$description": "panel padding (desktop); phone is 20px 16px" },
    "8": { "$value": "30px" },
    "section": { "$value": "96px", "$description": "vertical padding of each stop (desktop)" },
