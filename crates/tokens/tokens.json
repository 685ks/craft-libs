  "z": {
    "$type": "number",
    "sky": { "$value": -4 },
    "haze": { "$value": -3 },
    "map": { "$value": -2 },
    "veil": { "$value": -1 },
    "content": { "$value": 0 },
    "egg-card": { "$value": 2 },
    "sheet": { "$value": 60 }
